# Credenciais do Supabase (copie do seu painel em Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Chave service_role (Settings -> API -> service_role secret).
# NUNCA prefixar com NEXT_PUBLIC_ e nunca commitar o valor real:
# ela ignora todas as regras de segurança (RLS) e só pode ser usada no servidor
# (rotas em app/api/**). É necessária para criar usuários, subir PDFs e gerar
# links temporários de leitura.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta
